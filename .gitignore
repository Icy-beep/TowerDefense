# Байткод Python
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# Сборка (setuptools / PyInstaller)
build/
dist/
*.egg-info/
.eggs/

# Тесты / покрытие
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDE
.idea/
.vscode/

# Локальные настройки игрока (экран/звук/язык) — генерируются игрой, не для репозитория
settings.json

# Файлы-блокировки/автосохранения draw.io (открытая диаграмма создаёт
# .$Имя.drawio.bkp рядом с файлом — это не содержимое, а служебный мусор)
.$*.drawio.bkp

# ОС
.DS_Store
Thumbs.db

# Черновой звуковой/музыкальный материал (не используется игрой напрямую)
raw-sounds/
raw-music/

# OST-треки (слишком большие для репозитория, папки остаются)
assets/music/**/*.wav
assets/music/**/*.mp3
assets/music/**/*.ogg

# README-файлы внутри assets/ (локальная документация по ассетам, не нужна в репозитории)
assets/**/README.md

# docs

# other
.claudeignore
docs/PROJECT_REFERENCE.md
docs/DESIGN_RTS_TRANSITION.md
